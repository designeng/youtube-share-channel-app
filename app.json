{
  "expo": {
    "name": "Channel Viewer",
    "slug": "youtube-share-channel-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ic.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.designeng.channelviewer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DCE7FB",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.designeng.channelviewer"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosShareExtensionName": "Channel Viewer Share",
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ]
    ],
    "scheme": "channelviewer",
    "experiments": {
      "typedRoutes": true
    }
  }
}
